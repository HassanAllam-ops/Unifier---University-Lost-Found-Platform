@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<h4 class="mb-4 fw-bold">
    <i class="bi bi-speedometer2"></i> Welcome, @ViewBag.UserName 👋
</h4>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 text-center">
            <div style="font-size:2.5rem; color:#ef5350;">
                <i class="bi bi-exclamation-circle"></i>
            </div>
            <h2 class="fw-bold">@ViewBag.MyLost</h2>
            <p class="text-muted mb-0">My Lost Items</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 text-center">
            <div style="font-size:2.5rem; color:#66bb6a;">
                <i class="bi bi-check-circle"></i>
            </div>
            <h2 class="fw-bold">@ViewBag.MyFound</h2>
            <p class="text-muted mb-0">My Found Items</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 text-center">
            <div style="font-size:2.5rem; color:#ab47bc;">
                <i class="bi bi-link-45deg"></i>
            </div>
            <h2 class="fw-bold">@ViewBag.MyMatched</h2>
            <p class="text-muted mb-0">Matched Items</p>
        </div>
    </div>
</div>

<!-- Matched Alert -->
@if (ViewBag.MyMatched > 0)
{
    <div class="alert alert-purple mb-4" style="background:#f3e5f5; border-left: 4px solid #ab47bc; border-radius:10px;">
        <i class="bi bi-bell-fill" style="color:#ab47bc;"></i>
        <strong style="color:#ab47bc;"> Good news!</strong>
        One or more of your lost items have been matched! Go to
        <a href="/Student/MyItems" style="color:#ab47bc;">My Items</a> to see details.
    </div>
}

<!-- Recent Items -->
<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-clock-history"></i> My Recent Reports</h5>
        <a href="/Student/Report" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle"></i> Report New Item
        </a>
    </div>

    @if (ViewBag.RecentItems == null || ((List<Unifier___University_Lost___Found_Platform.Models.LostItem>)ViewBag.RecentItems).Count == 0)
    {
        <div class="text-center py-4 text-muted">
            <i class="bi bi-inbox" style="font-size:2.5rem;"></i>
            <p class="mt-2">No items reported yet.</p>
            <a href="/Student/Report" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Report an Item
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Item</th>
                        <th>Category</th>
                        <th>Location</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in (List<Unifier___University_Lost___Found_Platform.Models.LostItem>)ViewBag.RecentItems)
                    {
                        <tr>
                            <td><strong>@item.Title</strong></td>
                            <td>@item.Category</td>
                            <td><i class="bi bi-geo-alt"></i> @item.Location</td>
                            <td>@item.DateReported.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.Status == "Lost")
                                {
                                    <span class="badge-lost">Lost</span>
                                }
                                else if (item.Status == "Found")
                                {

                                    <span class="badge-found">Found</span>
                                }
                                else if (item.Status == "Matched")
                                {

                                    <span class="badge-matched">Matched ✓</span>
                                }
                                else
                                {

                                    <span class="badge-claimed">Claimed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <a href="/Student/MyItems" class="btn btn-outline-primary btn-sm mt-2">
            View All My Items
        </a>
    }
</div>