@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model Unifier___University_Lost___Found_Platform.Models.LostItem
@{
    ViewData["Title"] = "Report Item";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="card p-4" style="max-width:600px;">
    <h5 class="fw-bold mb-4">
        <i class="bi bi-plus-circle"></i> Report a Lost or Found Item
    </h5>

    <form method="post" action="/Student/Report">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label fw-bold">Your Email</label>
            <input type="text" class="form-control"
                   value="@HttpContextAccessor.HttpContext?.Session.GetString("UserEmail")"
                   disabled />
            <small class="text-muted">Auto-filled from your account</small>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Student ID *</label>
            <input type="text" name="StudentId" class="form-control"
                   placeholder="e.g. STU001" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Item Title *</label>
            <input type="text" name="Title" class="form-control"
                   placeholder="e.g. Black HP Laptop" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Description *</label>
            <textarea name="Description" class="form-control" rows="3"
                      placeholder="Describe the item in detail..." required></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Category *</label>
            <select name="Category" class="form-select" required>
                <option value="">-- Select Category --</option>
                <option>Electronics</option>
                <option>ID & Cards</option>
                <option>Bags</option>
                <option>Keys</option>
                <option>Books</option>
                <option>Clothing</option>
                <option>Other</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Location *</label>
            <input type="text" name="Location" class="form-control"
                   placeholder="e.g. Library - Floor 2" required />
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">Status *</label>
            <select name="Status" class="form-select" required>
                <option value="Lost">Lost - I am looking for it</option>
                <option value="Found">Found - I want to return it</option>
            </select>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-send"></i> Submit Report
            </button>
            <a href="/Student/Dashboard" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>