
@model Unifier___University_Lost___Found_Platform.Models.LostItem
@{
    ViewData["Title"] = "Delete Item";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="card p-4" style="max-width:500px;">
    <h5 class="fw-bold mb-3 text-danger">
        <i class="bi bi-trash"></i> Delete Item
    </h5>
    <p>Are you sure you want to delete this item?</p>

    <div class="alert alert-warning">
        <strong>@Model.Title</strong><br />
        <small>@Model.Description</small><br />
        <small><i class="bi bi-geo-alt"></i> @Model.Location</small>
    </div>

    <form method="post" action="/Student/DeleteConfirmed">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Yes, Delete
            </button>
            <a href="/Student/MyItems" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>