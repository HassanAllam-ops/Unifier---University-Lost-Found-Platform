@model List<Unifier___University_Lost___Found_Platform.Models.LostItem>
@{
    ViewData["Title"] = "My Items";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-list-ul"></i> My Reported Items</h5>
        <a href="/Student/Report" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle"></i> Report New Item
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox" style="font-size:3rem;"></i>
            <p class="mt-2">No items reported yet.</p>
            <a href="/Student/Report" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Report an Item
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Item</th>
                        <th>Category</th>
                        <th>Location</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr @(item.Status == "Matched" ? "style=background:#f3e5f5;" : "")>
                            <td>
                                <strong>@item.Title</strong><br />
                                <small class="text-muted">@item.Description</small>
                            </td>
                            <td>@item.Category</td>
                            <td>@item.Location</td>
                            <td>@item.DateReported.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.Status == "Lost")
                                {
                                    <span class="badge-lost">Lost</span>
                                }
                                else if (item.Status == "Found")
                                {

                                    <span class="badge-found">Found</span>
                                }
                                else if (item.Status == "Matched")
                                {

                                    <span class="badge-matched">✓ Matched</span>
                                }
                                else
                                {

                                    <span class="badge-claimed">Claimed</span>
                                }
                            </td>
                            <td>
                                @if (item.Status != "Matched" && item.Status != "Claimed")
                                {
                                    <a href="/Student/Details/@item.Id"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="/Student/Edit/@item.Id"
                                       class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="/Student/Delete/@item.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                                else
                                {
                                    <a href="/Student/Details/@item.Id"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
