@model Unifier___University_Lost___Found_Platform.Models.LostItem
@{
    ViewData["Title"] = "Item Details";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="card p-4" style="max-width:600px;">
    <h5 class="fw-bold mb-4"><i class="bi bi-info-circle"></i> Item Details</h5>

    @if (Model.Status == "Matched")
    {
        <div class="alert mb-4" style="background:#f3e5f5; border-left:4px solid #ab47bc; border-radius:10px;">
            <i class="bi bi-check-circle-fill" style="color:#ab47bc;"></i>
            <strong style="color:#ab47bc;"> This item has been matched!</strong><br />
            <small>Please visit the Lost & Found office to collect your item.</small>
        </div>
    }

    <table class="table table-bordered">
        <tr><th style="width:35%">Title</th><td>@Model.Title</td></tr>
        <tr><th>Description</th><td>@Model.Description</td></tr>
        <tr><th>Category</th><td>@Model.Category</td></tr>
        <tr><th>Location</th><td>@Model.Location</td></tr>
        <tr><th>Student ID</th><td>@Model.StudentId</td></tr>
        <tr><th>Date Reported</th><td>@Model.DateReported.ToString("dd/MM/yyyy")</td></tr>
        <tr>
            <th>Status</th>
            <td>
                @if (Model.Status == "Lost")
                {
                    <span class="badge-lost">Lost</span>
                }
                else if (Model.Status == "Found")
                {

                    <span class="badge-found">Found</span>
                }
                else if (Model.Status == "Matched")
                {

                    <span class="badge-matched">✓ Matched</span>
                }
                else
                {

                    <span class="badge-claimed">Claimed</span>
                }
            </td>
        </tr>
    </table>

    <a href="/Student/MyItems" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>