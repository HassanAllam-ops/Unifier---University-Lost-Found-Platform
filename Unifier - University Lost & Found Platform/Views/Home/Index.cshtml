@{
    ViewData["Title"] = "Dashboard";
}

<h4 class="mb-4 fw-bold">
    <i class="bi bi-speedometer2"></i> Welcome, @ViewBag.UserName 👋
</h4>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 text-center">
            <div style="font-size:2.5rem; color:#ef5350;">
                <i class="bi bi-exclamation-circle"></i>
            </div>
            <h2 class="fw-bold">@ViewBag.TotalLost</h2>
            <p class="text-muted mb-0">Lost Items</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 text-center">
            <div style="font-size:2.5rem; color:#66bb6a;">
                <i class="bi bi-check-circle"></i>
            </div>
            <h2 class="fw-bold">@ViewBag.TotalFound</h2>
            <p class="text-muted mb-0">Found Items</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 text-center">
            <div style="font-size:2.5rem; color:#42a5f5;">
                <i class="bi bi-bag-check"></i>
            </div>
            <h2 class="fw-bold">@ViewBag.TotalClaimed</h2>
            <p class="text-muted mb-0">Claimed Items</p>
        </div>
    </div>
</div>

<!-- Recent Items -->
<div class="card p-4">
    <h5 class="fw-bold mb-3"><i class="bi bi-clock-history"></i> Recent Reports</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Item</th>
                    <th>Category</th>
                    <th>Location</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ViewBag.RecentItems)
                {
                    <tr>
                        <td><strong>@item.Title</strong></td>
                        <td>@item.Category</td>
                        <td><i class="bi bi-geo-alt"></i> @item.Location</td>
                        <td>@item.DateReported.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.Status == "Lost")
                            {
                                <span class="badge badge-lost">Lost</span>
                            }
                            else if (item.Status == "Found")
                            {
                                <span class="badge badge-found">Found</span>
                            }
                            else
                            {
                                <span class="badge badge-claimed">Claimed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <a href="/Items/Search" class="btn btn-primary mt-2">
        <i class="bi bi-search"></i> View All Items
    </a>
</div>