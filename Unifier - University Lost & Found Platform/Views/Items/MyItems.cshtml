@model List<Unifier___University_Lost___Found_Platform.Models.LostItem>
@{
    ViewData["Title"] = "My Items";
}

<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-list-ul"></i> My Reported Items</h5>
        <a href="/Items/Report" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle"></i> Report New Item
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox" style="font-size:3rem;"></i>
            <p class="mt-2">You haven't reported any items yet.</p>
            <a href="/Items/Report" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Report an Item
            </a>
        </div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Item</th>
                    <th>Category</th>
                    <th>Location</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Title</strong><br />
                            <small class="text-muted">@item.Description</small>
                        </td>
                        <td>@item.Category</td>
                        <td>@item.Location</td>
                        <td>@item.DateReported.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.Status == "Lost")
                            {
                                <span class="badge badge-lost">Lost</span>
                            }
                            else if (item.Status == "Found")
                            {
                                <span class="badge badge-found">Found</span>
                            }
                            else
                            {
                                <span class="badge badge-claimed">Claimed</span>
                            }
                        </td>
                        <td>
                            <a href="/Items/Details/@item.Id" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <a href="/Items/Edit/@item.Id" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a href="/Items/Delete/@item.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>