@model Unifier___University_Lost___Found_Platform.Models.LostItem
@{
    ViewData["Title"] = "Report Item";
}

<div class="card p-4" style="max-width:600px;">
    <h5 class="fw-bold mb-4"><i class="bi bi-plus-circle"></i> Report a Lost or Found Item</h5>

    <form asp-action="Report" method="post">
        <div class="mb-3">
            <label class="form-label fw-bold">Item Title *</label>
            <input asp-for="Title" class="form-control" placeholder="e.g. Black HP Laptop" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Description *</label>
            <textarea asp-for="Description" class="form-control" rows="3"
                      placeholder="Describe the item in detail..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Category *</label>
            <select asp-for="Category" class="form-select">
                <option value="">-- Select Category --</option>
                <option>Electronics</option>
                <option>ID & Cards</option>
                <option>Bags</option>
                <option>Keys</option>
                <option>Books</option>
                <option>Clothing</option>
                <option>Other</option>
            </select>
            <span asp-validation-for="Category" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Location *</label>
            <input asp-for="Location" class="form-control" placeholder="e.g. Library - Floor 2" />
            <span asp-validation-for="Location" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label class="form-label fw-bold">Status *</label>
            <select asp-for="Status" class="form-select">
                <option value="Lost">Lost - I'm looking for it</option>
                <option value="Found">Found - I want to return it</option>
            </select>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-send"></i> Submit Report
            </button>
            <a href="/Items/Search" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>