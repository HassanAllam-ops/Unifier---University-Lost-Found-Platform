@model List<Unifier___University_Lost___Found_Platform.Models.LostItem>
@{
    ViewData["Title"] = "Admin Panel";
}

<h4 class="fw-bold mb-4"><i class="bi bi-shield-check"></i> Admin Dashboard</h4>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 text-center border-danger">
            <h2 class="fw-bold text-danger">@ViewBag.TotalLost</h2>
            <p class="mb-0">Lost</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 text-center border-success">
            <h2 class="fw-bold text-success">@ViewBag.TotalFound</h2>
            <p class="mb-0">Found</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 text-center border-info">
            <h2 class="fw-bold text-info">@ViewBag.TotalClaimed</h2>
            <p class="mb-0">Claimed</p>
        </div>
    </div>
</div>

<!-- All Items Table -->
<div class="card p-4">
    <h5 class="fw-bold mb-3">All Items</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Item</th>
                    <th>Category</th>
                    <th>Location</th>
                    <th>Reported By</th>
                    <th>Status</th>
                    <th>Change Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            <strong>@item.Title</strong><br />
                            <small class="text-muted">@item.Description</small>
                        </td>
                        <td>@item.Category</td>
                        <td>@item.Location</td>
                        <td><small>@item.ReportedByEmail</small></td>
                        <td>
                            @if (item.Status == "Lost")
                            {
                                <span class="badge badge-lost">Lost</span>
                            }
                            else if (item.Status == "Found")
                            {
                                <span class="badge badge-found">Found</span>
                            }
                            else
                            {
                                <span class="badge badge-claimed">Claimed</span>
                            }
                        </td>
                        <td>
                            <form asp-action="UpdateStatus" asp-controller="Admin"
                                  method="post" class="d-flex gap-1">
                                <input type="hidden" name="id" value="@item.Id" />
                                <select name="status" class="form-select form-select-sm"
                                        style="width:auto;">
                                    <option value="Lost">Lost</option>
                                    <option value="Found">Found</option>
                                    <option value="Claimed">Claimed</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>