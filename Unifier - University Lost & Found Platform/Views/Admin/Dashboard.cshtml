@using Unifier___University_Lost___Found_Platform.Models
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var allItems = ViewBag.AllItems as List<LostItem>;
}

<h4 class="fw-bold mb-4">
    <i class="bi bi-speedometer2"></i> Admin Dashboard
</h4>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-4 text-center" style="border-top: 4px solid #ef5350;">
            <div style="font-size:2.5rem; color:#ef5350;">
                <i class="bi bi-exclamation-circle"></i>
            </div>
            <h2 class="fw-bold mt-2">@ViewBag.TotalLost</h2>
            <p class="text-muted mb-0">Lost Items</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-4 text-center" style="border-top: 4px solid #66bb6a;">
            <div style="font-size:2.5rem; color:#66bb6a;">
                <i class="bi bi-check-circle"></i>
            </div>
            <h2 class="fw-bold mt-2">@ViewBag.TotalFound</h2>
            <p class="text-muted mb-0">Found Items</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-4 text-center" style="border-top: 4px solid #ab47bc;">
            <div style="font-size:2.5rem; color:#ab47bc;">
                <i class="bi bi-link-45deg"></i>
            </div>
            <h2 class="fw-bold mt-2">@ViewBag.TotalMatched</h2>
            <p class="text-muted mb-0">Matched Items</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-4 text-center" style="border-top: 4px solid #42a5f5;">
            <div style="font-size:2.5rem; color:#42a5f5;">
                <i class="bi bi-bag-check"></i>
            </div>
            <h2 class="fw-bold mt-2">@ViewBag.TotalClaimed</h2>
            <p class="text-muted mb-0">Claimed Items</p>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card p-4 d-flex flex-row align-items-center gap-4"
             style="border-left: 5px solid #1a237e;">
            <div style="font-size:3rem; color:#1a237e;">
                <i class="bi bi-arrow-left-right"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-1">Match Items</h5>
                <p class="text-muted mb-2">Compare Lost & Found items and match them together</p>
                <a href="/Admin/MatchItems" class="btn btn-primary btn-sm px-4">
                    <i class="bi bi-arrow-left-right"></i> Go to Match
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-4 d-flex flex-row align-items-center gap-4"
             style="border-left: 5px solid #42a5f5;">
            <div style="font-size:3rem; color:#42a5f5;">
                <i class="bi bi-grid"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-1">All Items</h5>
                <p class="text-muted mb-2">View and manage all reported items from all students</p>
                <a href="/Admin/AllItems" class="btn btn-outline-primary btn-sm px-4">
                    <i class="bi bi-grid"></i> View All
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Items Table -->
<div class="card p-4">
    <h5 class="fw-bold mb-3"><i class="bi bi-clock-history"></i> Recent Reports</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Item</th>
                    <th>Category</th>
                    <th>Reported By</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (allItems != null)
                {
                    @foreach (var item in allItems.Take(5))
                    {
                        <tr>
                            <td><strong>@item.Title</strong></td>
                            <td>@item.Category</td>
                            <td><small>@item.ReportedByEmail</small></td>
                            <td>@item.DateReported.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.Status == "Lost")
                                {
                                    <span class="badge-lost">Lost</span>
                                }
                                else if (item.Status == "Found")
                                {

                                    <span class="badge-found">Found</span>
                                }
                                else if (item.Status == "Matched")
                                {

                                    <span class="badge-matched">✓ Matched</span>
                                }
                                else
                                {

                                    <span class="badge-claimed">Claimed</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <a href="/Admin/AllItems" class="btn btn-outline-primary btn-sm mt-2">
        View All Items
    </a>
</div>