@model Unifier___University_Lost___Found_Platform.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Unifier</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
            body {
                background: linear-gradient(135deg, #1a237e, #283593, #3949ab);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .login-card {
                background: white;
                border-radius: 20px;
                padding: 40px;
                width: 100%;
                max-width: 420px;
                box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            }

            .login-logo {
                font-size: 3rem;
                color: #1a237e;
            }

            .btn-login {
                background: linear-gradient(135deg, #1a237e, #3949ab);
                border: none;
                border-radius: 10px;
                padding: 12px;
                font-size: 1.1rem;
                font-weight: bold;
                width: 100%;
                color: white;
            }

                .btn-login:hover {
                    opacity: 0.9;
                    color: white;
                }

            .form-control {
                border-radius: 10px;
                padding: 12px;
                border: 2px solid #e0e0e0;
            }

                .form-control:focus {
                    border-color: #1a237e;
                    box-shadow: none;
                }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="login-logo"><i class="bi bi-search-heart"></i></div>
            <h2 class="fw-bold mt-2" style="color:#1a237e">Unifier</h2>
            <p class="text-muted">University Lost & Found Platform</p>
        </div>

        <form method="post" action="/Account/Login">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-bold">Email</label>
                <input type="email" name="Email" class="form-control"
                       placeholder="example@university.edu"
                       value="@Model?.Email" />
                <span class="text-danger small">
                    @Html.ValidationMessage("Email")
                </span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Password</label>
                <input type="password" name="Password" class="form-control"
                       placeholder="••••••••" />
                <span class="text-danger small">
                    @Html.ValidationMessage("Password")
                </span>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(""))
            {
                <div class="alert alert-danger rounded-3 mb-3">
                    <i class="bi bi-exclamation-circle"></i>
                    Invalid email or password. Please try again.
                </div>
            }

            <button type="submit" class="btn-login btn">
                <i class="bi bi-box-arrow-in-right"></i> Login
            </button>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>